{
  "appId": "com.translyai.app",
  "appName": "TranslyAi",
  "webDir": "dist",
  "backgroundColor": "#060606",
  "android": {
    "backgroundColor": "#060606"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#060606",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#060606"
    }
  }
}
