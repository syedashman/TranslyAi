# Shared environment variables
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional. Only used to durably mirror "Start Meeting" job results into the meetings table (see
# supabase/meetings.sql) so they survive a server restart - the feature itself works without it (state lives
# in the backend's memory while the job runs). Never sent to or used by the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hugging Face Inference API
HF_API_KEY=your_huggingface_api_key

# Groq (Whisper speech-to-text)
GROQ_API_KEY=your_groq_api_key

# ElevenLabs (Scribe v2 speech-to-text, primary STT provider with automatic Groq Whisper fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Which STT provider /api/transcribe and /api/audio use: "elevenlabs" (default; auto-falls back to Groq Whisper
# on any failure) or "whisper" (Groq only, no fallback)
STT_PROVIDER=elevenlabs
# Optional comma-separated words/phrases to bias ElevenLabs Scribe v2 towards (product names, jargon, etc.)
ELEVENLABS_KEYTERMS=

# Model configuration
WHISPER_MODEL=small
NLLB_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M

# Live Meeting (browser tab audio -> realtime ElevenLabs Scribe v2 -> Gemini). Uses ELEVENLABS_API_KEY above; no
# extra paid service. All optional - these are the defaults.
LIVE_MEETING_ENABLED=true
# Largest single WebSocket message accepted from the browser, in bytes
LIVE_WS_MAX_MESSAGE_SIZE=65536
# Finalized sentences waiting for Gemini before further ones are parked (still translated, just not queued yet)
LIVE_TRANSLATION_QUEUE_SIZE=200
# 0 = no cap. Default 4 hours, only so an abandoned session can never run forever.
LIVE_MEETING_MAX_DURATION_SECONDS=14400
# Seconds of total silence from the browser before its connection is treated as dead
LIVE_WS_IDLE_TIMEOUT_SECONDS=45
# How long a live meeting waits for the browser to reconnect before saving what it captured
LIVE_RECONNECT_GRACE_SECONDS=90
# Language hint for Live Meeting speech-to-text (ElevenLabs Scribe). "ur" is the default and is reliable for
# Urdu / Hinglish speech (English is still transcribed as English). Leave it empty to enable auto-detection.
LIVE_STT_LANGUAGE_CODE=ur
# Server-side debugging only. When true, the server log may include raw speech-to-text and Romanizer diagnostic data.
# Keep it false by default. This data is only written to the server log - it is never sent to clients or saved.
LIVE_STT_DEBUG=false

# Live Meeting sharing (read-only viewers, guests need no account). All optional - these are the defaults.
# Max people watching one live meeting
LIVE_MAX_VIEWERS=200
# How long a FINISHED live meeting stays viewable through its share link (seconds; 86400 = 24 h). The host's saved
# meeting is never affected by this.
LIVE_SHARE_TTL_SECONDS=86400
# How long a guest has to sign up and save a copy of the meeting they watched (seconds; 604800 = 7 days)
LIVE_CLAIM_TTL_SECONDS=604800
# Optional secret that signs those save tokens. Empty = derived from SUPABASE_SERVICE_ROLE_KEY.
LIVE_CLAIM_SECRET=
