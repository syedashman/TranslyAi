# Shared environment variables
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional. Only used to durably mirror "Start Meeting" job results into the meetings table (see
# supabase/meetings.sql) so they survive a server restart - the feature itself works without it (state lives
# in the backend's memory while the job runs). Never sent to or used by the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hugging Face Inference API
HF_API_KEY=your_huggingface_api_key

# Groq (Whisper speech-to-text)
GROQ_API_KEY=your_groq_api_key

# ElevenLabs (Scribe v2 speech-to-text, primary STT provider with automatic Groq Whisper fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Which STT provider /api/transcribe and /api/audio use: "elevenlabs" (default; auto-falls back to Groq Whisper
# on any failure) or "whisper" (Groq only, no fallback)
STT_PROVIDER=elevenlabs
# Optional comma-separated words/phrases to bias ElevenLabs Scribe v2 towards (product names, jargon, etc.)
ELEVENLABS_KEYTERMS=

# Model configuration
WHISPER_MODEL=small
NLLB_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
